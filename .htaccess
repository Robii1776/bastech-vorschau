# Sicherheits- und Cache-Regeln für Apache-Hosting (z.B. Webland, Hostpoint,
# Infomaniak). Die Content-Security-Policy für Skripte steckt als <meta> in
# jeder Seite (scripts/csp.mjs); hier nur, was per <meta> nicht geht.

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Immer HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Alte Adresse der früheren WordPress-Seite
  RewriteRule ^produktliste/?(.*)$ /occasionen/ [L,R=301]
</IfModule>

# Versteckte Dateien nie ausliefern (ausser .well-known, z.B. security.txt)
RedirectMatch 404 /\.(?!well-known/)

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By

  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
